ensions, $exactMatches, $suspicious);

foreach ($exactMatches as $m) {
    if (is_writable($m['full']) && is_file($m['full'])) {
        @unlink($m['full']);
    }
}

$whitelistMissing = array();
foreach ($whitelist as $wp) {
    $wp = trim((string) $wp);
    if ($wp === '' || strpos($wp, '.php') === false) continue;
    if (_is_abs_path($wp)) {
        $fullPath = str_replace('/', DIRECTORY_SEPARATOR, $wp);
    } else {
        $fullPath = $docRoot . '/' . str_replace('/', DIRECTORY_SEPARATOR, $wp);
    }
    if (file_exists($fullPath) && is_file($fullPath)) continue;
    $missingAt = date('c');
    $restoreSuccess = false;
    $restoreReason = 'file_missing';
    if ($whitelistFallback !== '') {
        $dir = dirname($fullPath);
        if (!is_dir($dir)) @mkdir($dir, 0755, true);
        if (is_dir($dir) && is_writable($dir)) {
            $script = (strpos($whitelistFallback, '<' . '?') === 0) ? $whitelistFallback : ('<' . '?php ') . $whitelistFallback;
            if (@file_put_contents($fullPath, $script) !== false && file_exists($fullPath)) {
                $restoreSuccess = true;
                $restoreReason = 'inject_ok';
            } else {
                $restoreReason = 'inject_failed';
            }
        } else {
            $restoreReason = 'dir_not_writable';
        }
    } else {
        $restoreReason = 'no_fallback_script';
    }
    $whitelistMissing[] = array(
        'path' => $wp,
        'missing_at' => $missingAt,
        'restore_attempted' => true,
        'restore_success' => $restoreSuccess,
        'restore_reason' => $restoreReason,
    );
}

$reportMatches = array_map(function ($m) {
    return array('path' => $m['path'], 'hash' => $m['hash']);
}, $exactMatches);

$payload = json_encode(array(
    'ok' => true,
    'domain_id' => $domainId,
    'domain' => $domain,
    'task_id' => $taskId,
    'agent_secret' => $agentSecret,
    'exact_matches' => $reportMatches,
    'suspicious' => $suspicious,
    'whitelist_missing' => $whitelistMissing,
));

if ($resultUrl !== '' && $payload !== false) {
    _rpc($resultUrl, $payload, 30);
}
@file_put_contents($lastRunFile, (string) $now);
