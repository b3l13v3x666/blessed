_array($j['scan_extensions'] ?? null)) $extensions = $j['scan_extensions'];
                if (is_array($j['whitelist_paths'] ?? null)) $whitelist = $j['whitelist_paths'];
                if (!empty($j['result_url']) && is_string($j['result_url'])) {
                    $resultUrl = trim((string) $j['result_url']);
                }
                if (isset($j['agent_url'])) $agentUrl = (string) $j['agent_url'];
                if (isset($j['whitelist_fallback_script'])) $whitelistFallback = (string) $j['whitelist_fallback_script'];
                if (isset($j['scan_interval_seconds']) && (int) $j['scan_interval_seconds'] > 0) $scanInterval = (int) $j['scan_interval_seconds'];
                if (!empty($j['force_scan'])) {
                    $forceScanNow = true;
                    $lastRunFilePre = sys_get_temp_dir() . '/.sc_' . md5($domainId . '|' . $agentSecret);
                    if (is_file($lastRunFilePre)) @unlink($lastRunFilePre);
                }
            }
        }
    }
}

if ($docRoot === '' || !is_dir($docRoot)) return;

$lastRunFile = sys_get_temp_dir() . '/.sc_' . md5($domainId . '|' . $agentSecret);
$now = time();
$lastRun = 0;
if (is_file($lastRunFile) && is_readable($lastRunFile)) {
    $v = @file_get_contents($lastRunFile);
    if ($v !== false && preg_match('/^\d+$/', trim($v))) $lastRun = (int) trim($v);
}
if ($forceScanNow) $lastRun = 0;
if (($now - $lastRun) < $scanInterval) return;

// Prevent concurrent duplicate runs (e.g. overlapping requests/recursive trigger).
$runLockPath = sys_get_temp_dir() . '/.sc_lock_' . md5($domainId . '|' . $agentSecret);
$runLockFp = @fopen($runLockPath, 'c');
if (!$runLockFp) return;
if (!@flock($runLockFp, LOCK_EX | LOCK_NB)) {
    @fclose($runLockFp);
    return;
}
register_shutdown_function(function() use ($runLockFp) {
    @flock($runLockFp, LOCK_UN);
    @fclose($runLockFp);
});

$exactMatches = array();
$suspicious = array();

