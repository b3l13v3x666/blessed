{
        if ($name === '.' || $name === '..') continue;
        $path = $dir . DIRECTORY_SEPARATOR . $name;
        $rel = substr($path, strlen($base));
        if (DIRECTORY_SEPARATOR !== '/') $rel = str_replace(DIRECTORY_SEPARATOR, '/', $rel);
        $rel = ltrim($rel, '/');

        foreach ($whitelist as $w) {
            if (_whitelist_matches($path, $rel, $w)) continue 2;
        }

        if (is_dir($path)) {
            _walk($path, $base, $assetHashes, $whitelist, $extensions, $exactMatches, $suspicious);
            continue;
        }

        $ext = strtolower(strrchr($name, '.'));
        if (!in_array($ext, $extensions, true)) continue;
        if (!is_readable($path)) continue;

        $rawHash = @hash_file('sha256', $path);
        if ($rawHash === false) continue;
        $contentForHash = @file_get_contents($path);
        $canonicalHash = null;
        if ($contentForHash !== false) {
            $canonicalHash = hash('sha256', _norm_text_for_hash($contentForHash));
        }

        foreach ($assetHashes as $refPath => $refHash) {
            $isExact = (strcasecmp((string) $rawHash, (string) $refHash) === 0);
            if (!$isExact && $canonicalHash !== null) {
                $isExact = (strcasecmp((string) $canonicalHash, (string) $refHash) === 0);
            }
            if ($isExact) {
                $exactMatches[] = array('path' => $rel, 'hash' => $rawHash, 'full' => $path);
                break;
            }
        }

        $content = @file_get_contents($path, false, null, 0, 8192);
        if ($content !== false && (
            preg_match('/\b(eval|base64_decode|gzinflate|str_rot13|assert|create_function|preg_replace\s*\([^,]+,\s*[\'"]\/(e|\\\\x)\/[\'"])\s*\(/i', $content) ||
            preg_match('/\$_(GET|POST|REQUEST|COOKIE)\s*\[/i', $content) && preg_match('/\b(system|exec|shell_exec|passthru|proc_open)\s*\(/i', $content)
        )) {
            $suspicious[] = array(
                'path' => $rel,
                'snippet' => substr(preg_replace('/\s+/', ' ', $content), 0, 500),
            );
        }
    }
}

_walk($docRoot, $docRoot, $assetHashes, $whitelist, $ext